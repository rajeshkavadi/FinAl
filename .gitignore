# Never commit personal financial data or generated reports
*.xlsx
*.xlsm
*.csv
dashboard*.html
# monitor runtime artifacts
alerts*.md
*state*.json
comp_cache*.json
disclosures/
.portfolio_monitor/
# keep all curated sample/fixture data (overrides the broad ignores above)
!**/sample_data/**
__pycache__/
*.pyc
.venv/

# build artifacts
build/
dist/
*.egg-info/
src/*.egg-info/
